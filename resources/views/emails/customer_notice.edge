<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
  </head>
  <body style="margin:0;padding:0;background:#f5f5f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0a0a0b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f6;padding:32px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;background:#ffffff;border:1px solid #dddfe2;border-radius:12px;">
            <tr>
              <td style="padding:28px 28px 8px;font-size:14px;font-weight:600;color:#6b6f76;">
                {{ brandName }}
              </td>
            </tr>
            <tr>
              <td style="padding:0 28px;">
                <h1 style="margin:8px 0 12px;font-size:20px;line-height:1.3;">{{ title }}</h1>
                @each(line in lines)
                  <p style="margin:0 0 12px;font-size:15px;line-height:1.55;color:#2a2c30;">{{ line }}</p>
                @end
                @if(code)
                  <p style="margin:20px 0;padding:14px 0;text-align:center;font-size:30px;font-weight:700;letter-spacing:8px;background:#f5f5f6;border-radius:8px;font-family:ui-monospace,Menlo,Consolas,monospace;">{{ code }}</p>
                @end
                @if(actionUrl)
                  <p style="margin:20px 0;">
                    <a href="{{ actionUrl }}" style="display:inline-block;padding:10px 18px;background:#2563eb;color:#ffffff;border-radius:8px;text-decoration:none;font-size:14px;font-weight:600;">{{ actionLabel }}</a>
                  </p>
                @end
              </td>
            </tr>
            <tr>
              <td style="padding:8px 28px 28px;font-size:12.5px;line-height:1.5;color:#6b6f76;">
                {{ footer }}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
