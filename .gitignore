# Dependencies and AdonisJS build
node_modules
build

# Yarn 4. The vendored release is committed; the cache is not.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
tmp/*
!tmp/.gitkeep

# Secrets — never commit real env files (CI and docs use .env.example / .env.test)
.env
.env.*
!.env.example
!.env.test

# Frontend assets compiled code
public/assets

# Build tools specific
npm-debug.log
yarn-error.log

# Editors specific
.fleet
.idea
.vscode

# Platform specific
.DS_Store

# Local Drive uploads
storage
private_storage
