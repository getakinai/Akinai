{
  "name": "akinai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "homepage": "https://getakinai.com",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint app inertia --fix",
    "lint:check": "eslint app inertia",
    "format": "prettier --write app database inertia",
    "format:check": "prettier --check app database inertia",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "security:audit": "sh scripts/security-audit.sh",
    "db:migrate": "node ace migration:run",
    "db:migration:force": "node ace migration:run --force",
    "db:seed": "node ace db:seed",
    "db:seed:demo": "node ace db:seed && node ace seed:demo-store",
    "search:sync": "node ace search:reindex-products",
    "search:sync:fresh": "node ace search:reindex-products --fresh",
    "docker:up": "docker compose -f .infra/docker-compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f .infra/docker-compose.yml --env-file .env down --remove-orphans",
    "docker:logs": "docker compose -f .infra/docker-compose.yml --env-file .env logs -f",
    "docker:ps": "docker compose -f .infra/docker-compose.yml --env-file .env ps",
    "prepare": "husky"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#documents/*": "./app/documents/*.js",
    "#services/*": "./app/services/*.js",
    "#repositories/*": "./app/repositories/*.js",
    "#search/*": "./app/search/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#constants/*": "./app/constants/*.js",
    "#utils/*": "./app/utils/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#plugin_host/*": "./app/plugins/*.js",
    "#theme_host/*": "./app/themes/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-beautify": "^1.14.3",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hot-hook": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/ally": "^6.3.2",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.1",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/redis": "^11.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/transmit": "^3.0.2",
    "@adonisjs/transmit-client": "^1.1.0",
    "@adonisjs/vite": "^6.0.2",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@foadonis/magnify": "^0.3.2",
    "@foadonis/maintenance": "^0.1.2",
    "@foadonis/shopkeeper": "^1.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@inertiajs/core": "^3.9.1",
    "@inertiajs/react": "^3.9.1",
    "@smastrom/react-rating": "^1.5.0",
    "@tanstack/react-query": "^5.104.2",
    "@tuyau/core": "^1.2.2",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vinejs/vine": "^4.4.0",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3",
    "edge.js": "^6.5.1",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "js-beautify": "^2.0.3",
    "lucide-react": "^1.55.0",
    "luxon": "^3.7.2",
    "mailchecker": "^6.0.21",
    "marked": "^18.1.0",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-date-range": "^2.0.1",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "slate": "^0.133.3",
    "slate-dom": "^0.133.1",
    "slate-history": "^0.128.1",
    "slate-react": "^0.133.4",
    "snappycart": "^1.2.6",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "typesense": "^3.1.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.6"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "resolutions": {
    "nodemailer": "^10.0.5",
    "typesense": "^3.1.1"
  },
  "prettier": "@adonisjs/prettier-config",
  "lint-staged": {
    "app/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "inertia/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "database/**/*.ts": [
      "prettier --write"
    ]
  }
}
