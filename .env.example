# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=Storefront
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session. `database` stores sessions in the `sessions` table so they can be
# revoked server-side; production refuses to boot with any other driver.
SESSION_DRIVER=database

# Security headers. Set to false while any subdomain still serves plain HTTP.
HSTS_INCLUDE_SUBDOMAINS=true

# Staff must turn on two-step verification (authenticator app) before they can
# use the back office. They can still reach /admin/account/security to set it up.
REQUIRE_STAFF_MFA=false

# First-run setup. While no staff User exists, /admin/setup creates the first
# admin after this token is entered. Use 32+ random characters
# (openssl rand -hex 32), and remove it once the first admin exists.
# `yarn setup` fills this in for local development.
SETUP_TOKEN=

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_DATABASE=app

# Test database (local Docker Compose `databaseTest`; CI installs Postgres via apt)
TEST_DB_PORT=5433
TEST_DB_USER=test
TEST_DB_PASSWORD=test
TEST_DB_DATABASE=test

# Mailpit (local SMTP catcher). 1025-1026 can be taken by macOS FinderSync.
MAILPIT_SMTP_PORT=2525
MAILPIT_UI_PORT=8025

# Google autocomplete
GOOGLE_AUTOCOMPLETE_ADDRESS_API_KEY=xxxxxxx

# Customer social sign-in. Register these redirect URLs in Google Cloud and
# Microsoft Entra (personal Microsoft accounts only).
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_CLIENT_REDIRECT_URL=http://localhost:3333/google/oauth/callback
MICROSOFT_CLIENT_ID=xxx-xxxx-xxx-xxx
MICROSOFT_CLIENT_SECRET=xxxxxx
MICROSOFT_CLIENT_REDIRECT_URL=http://localhost:3333/microsoft/oauth/callback
MICROSOFT_OAUTH_APPLICATION=consumers

# Product search (Typesense). TYPESENSE_PORT is the host port for docker compose.
SEARCH_ENGINE=typesense
TYPESENSE_NODE_URL=http://localhost:8108
TYPESENSE_API_KEY=xyz
TYPESENSE_PORT=8108

# File uploads (AdonisJS Drive). `fs` stores files in storage/ and serves them at /uploads.
# Production (NODE_ENV=production) always uses S3 and ignores DRIVE_DISK / DRIVE_PRIVATE_DISK.
# It refuses to boot unless AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION and S3_BUCKET
# are set. Leave S3_ENDPOINT empty for AWS. CDN_URL (e.g. CloudFront) is optional.
DRIVE_DISK=fs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_ENDPOINT=
CDN_URL=
# Private uploads (payment proofs) are never linked publicly. `fsPrivate` stores them in
# private_storage/. On S3 they use S3_PRIVATE_BUCKET (no public access) or, if unset, S3_BUCKET
# under the `private/` prefix: then block `/private/*` in the CDN. Defaults follow DRIVE_DISK.
DRIVE_PRIVATE_DISK=fsPrivate
S3_PRIVATE_BUCKET=

# Rate limiting (@adonisjs/limiter). Redis is started by `yarn docker:up`.
# Production refuses to boot with LIMITER_STORE=memory.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
LIMITER_STORE=redis
# Live admin notifications over Redis pub/sub (memory = in-process, tests only).
ADMIN_EVENTS_TRANSPORT=redis

# Google reCAPTCHA v3 on login, signup and checkout. Create v3 keys at
# https://www.google.com/recaptcha/admin. The site key is public (sent to the browser).
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
VITE_RECAPTCHA_SITE_KEY=

# Mail (@adonisjs/mail). Locally this points at Mailpit (inbox at http://localhost:8025).
# Set SMTP_USERNAME / SMTP_PASSWORD when the SMTP server needs authentication.
MAIL_MAILER=smtp
MAIL_FROM_NAME=Storefront
MAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Reject passwords found in known data breaches (HaveIBeenPwned k-anonymity API)
PWNED_PASSWORDS_ENABLED=true